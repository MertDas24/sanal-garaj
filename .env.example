# Sanal Garaj'ın tarayıcıda çalışan sürümü HİÇBİR ortam değişkeni veya gizli anahtar gerektirmez.
# Bu dosya yalnızca isteğe bağlı geliştirme araçları içindir. Gerçek değerleri .env.local dosyasına yazın
# (.gitignore kapsamındadır); bu dosyaya veya tarayıcı koduna (VITE_ ile başlayan değişkenlere) anahtar koymayın.

# Küçük resim üretimi (scripts/render-thumbs.mjs) için geliştirme sunucusu adresi
THUMB_BASE=http://localhost:5199/

# Playwright'ın kullanacağı tarayıcı kanalı (boş: Playwright'ın kendi Chromium'u; "chrome": kurulu Chrome)
PW_CHANNEL=
